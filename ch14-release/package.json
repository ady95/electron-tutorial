{
  "name": "ch14-release",
  "productName": "AI 채팅",
  "version": "1.0.1",
  "private": true,
  "description": "14장: GitHub Actions 빌드와 자동 업데이트",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Electron 따라하기"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "check:security": "node scripts/check-security.mjs",
    "test": "vitest run",
    "proxy": "node --env-file-if-exists=proxy/.env proxy/server.mjs",
    "test:watch": "vitest",
    "test:electron": "node scripts/test-electron.mjs",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e": "npm run package && playwright test",
    "smoke:packaged": "node tests/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "1.64.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.3.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "electron-squirrel-startup": "^1.0.1",
    "marked": "18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "update-electron-app": "3.3.0"
  }
}
