# 회사 중계 서버 설정. 이 파일을 proxy/.env로 복사해 값을 채운다 (git에 올리지 않는다)

# 진짜 LLM 서버와 API 키 (이 서버에만 둔다)
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=

# 허용할 모델 (쉼표로 구분)
ALLOWED_MODELS=

# 사용자와 토큰 "이름:토큰" (쉼표로 구분). 운영에서는 회사 로그인으로 발급한다
PROXY_USERS=alice:change-me-alice-token,bob:change-me-bob-token

# 사용자별 1분당 요청 수, 출력 길이 상한
RATE_PER_MIN=10
MAX_TOKENS=2000

PORT=8787
HOST=127.0.0.1
