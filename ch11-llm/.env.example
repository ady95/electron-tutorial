# 개발용 LLM 설정. 이 파일을 .env로 복사해 값을 채운다 (.env는 git에 올리지 않는다)
# 앱의 설정 화면에 값을 저장하면 그 값이 먼저 쓰인다

# OpenAI 호환 서버
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# 회사 중계 서버 (11-2, npm run proxy). 키 자리에 사용자 토큰을 넣는다
CHAT_PROXY_URL=http://127.0.0.1:8787/v1
CHAT_PROXY_TOKEN=
CHAT_PROXY_MODEL=
